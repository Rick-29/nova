# Copy to `.env` (gitignored). `cargo xtask` loads it before anything else;
# variables already set in the shell win over this file.

# PyPI: token from https://pypi.org/manage/account/token/ (starts with pypi-)
MATURIN_PYPI_TOKEN=pypi-...

# Self-hosted GitLab for the `gitlab` publisher (also run `glab auth login --hostname $GITLAB_HOST` once)
GITLAB_HOST=gitlab.chipatrade.com
# Alternative to `glab auth login`: a personal access token with the `api` scope
# GITLAB_TOKEN=glpat-...

# GitHub: not needed when `gh auth login` was run; otherwise a token with `repo` scope
# GH_TOKEN=ghp_...

# crates.io: not needed when `cargo login` was run; otherwise
# CARGO_REGISTRY_TOKEN=...

# RubyGems (only if the ruby `publish` steps are enabled): run `gem signin` once instead,
# or set GEM_HOST_API_KEY=rubygems_...
